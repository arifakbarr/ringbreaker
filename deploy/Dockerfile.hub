# Build the React UI first so the hub serves it at "/" (no host-side `npm run build` needed).
FROM node:22-alpine AS ui
WORKDIR /ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ ./
RUN npm run build

FROM python:3.12-slim AS base
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY pyproject.toml README.md ./
COPY src ./src
COPY results ./results
COPY --from=ui /ui/dist ./ui/dist
RUN pip install --no-cache-dir -e .
ENV SERVICE_ROLE=hub PORT=8080
EXPOSE 8080
CMD ["uvicorn", "ringbreaker.hub.service:app", "--host", "0.0.0.0", "--port", "8080"]
